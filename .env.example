# Copy this file to .env and replace the empty values with your real settings.
# These variables configure the app logging, local download paths, external manga sources,
# file synchronization, messaging infrastructure, and Telegram notifications.

# General application settings
GENERAL_LOG_LEVEL=info
DOWNLOAD_FOLDER=~/Desktop/Manga_downloads
VIDEO_DOWNLOAD_FOLDER=~/Desktop/Video_downloads

# Manga source domains used by the scraper strategies.
# Update these values if your preferred manga providers or mirror URLs change.
MANGASTRATEGY_E_MANGA_DOMAIN=https://mangadex.org
MANGASTRATEGY_TMH_MANGA_DOMAIN=https://mangadex.org
MANGASTRATEGY_TM_MANGA_DOMAIN=https://mangadex.org

# WebDAV storage settings for uploading downloaded files.
WEBDAV_URL=
WEBDAV_USER=
WEBDAV_PASSWORD=

# RabbitMQ connection details for queue processing.
RABBITMQ_URL=amqp://192.168.3.39:5672/
RABBITMQ_HOST=192.168.3.39
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# Azure Service Bus settings for asynchronous messaging.
AZURESERVICEBUS_CONNECTION_STRING=
AZURESERVICEBUS_QUEUE_NAME=

# Telegram bot token used for user notifications and feedback.
TELEGRAMBOT_TOKEN=
